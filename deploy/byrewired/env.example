# Copy to .env next to the compose file and fill in. Keep it out of git.

# The address people visit. Has to match the Cloudflare tunnel hostname
# exactly, including https and no trailing slash.
BASEROW_PUBLIC_URL=https://db.example.com

# openssl rand -hex 32
SECRET_KEY=
BASEROW_JWT_SIGNING_KEY=
DATABASE_PASSWORD=

# Zero Trust dashboard, Networks, Tunnels, create a tunnel and copy the token.
TUNNEL_TOKEN=

# 4GB host and up can leave these alone. On a 1GB instance drop both to 1 and
# add swap, or the kernel will kill the web worker under load.
GUNICORN_WORKERS=2
CELERY_WORKERS=1
